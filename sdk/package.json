{
  "name": "@hergmes/sdk",
  "version": "0.0.1-alpha",
  "private": true,
  "description": "Client for the hergmes relay: realtime, mempool-aware boxes and balances on Ergo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nautls/hergmes.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/nautls/hergmes/tree/master/sdk#readme",
  "bugs": "https://github.com/nautls/hergmes/issues",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && pnpm --dir examples/vue build",
    "check": "tsc && pnpm --dir examples/vue check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fleet-sdk/common": "^0.10.0",
    "@fleet-sdk/serializer": "^0.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
